# Postgres connection string, e.g. from Neon/Supabase/Railway or a local instance
DATABASE_URL="postgresql://user:password@localhost:5432/foroz"

# Origin allowed to call this API (the frontend dev server / production domain)
FRONTEND_ORIGIN="http://localhost:5173"

PORT=4000

# Optional — donations run in "not configured" mode (no real charge, logs + a
# typed response) until this is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — contact/newsletter notifications stay DB-only (no email sent)
# until this is set. Wire up at Alpha.
RESEND_API_KEY=
